# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# ===== 编辑器与本地机器配置（含数据库口令，绝不入库）=====
.vscode/settings.json

# ===== 误产生的垃圾文件（PowerShell 重定向/命令拼写事故）=====
$null
Get-ChildItem
utputFormat
_patch_utils.js
frontend-sync.zip

# ===== Prisma =====
/prisma/generated
